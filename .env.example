# OpenAI API Configuration
OPENAI_API_KEY=your-api-key-here

# Vision API Settings
# Set to 'true' to use GPT-4 Vision API for images (costs ~$0.0006 per image with gpt-4o-mini)
# Set to 'false' to use traditional Tesseract OCR (free, slower, text-only)
USE_VISION_API=false

# Vision Model Selection (only used if USE_VISION_API=true)
# Options: gpt-4o-mini (cheaper, recommended) or gpt-4o (higher quality, more expensive)
VISION_MODEL=gpt-4o-mini

# Maximum images to analyze per file (cost control)
# Set to 0 for unlimited. Recommended: 5-20 depending on use case
MAX_IMAGES_PER_FILE=5

# Tesseract OCR Path (Windows only, only used if USE_VISION_API=false)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
